# Example environment variables for the backend. Set these in your shell or IDE
# run configuration. Don't commit real values.
DB_URL=jdbc:mariadb://localhost:3306/pantrypal
DB_USERNAME=root
DB_PASSWORD=your-local-db-password
FRONTEND_URL=http://localhost:8081

# Secret used to sign login tokens. At least 32 characters. Use your own long
# random value anywhere other than your own computer, e.g. `openssl rand -base64 48`.
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# How long a login lasts (days)
JWT_EXPIRATION_DAYS=7

# Only needed once you turn OAuth back on:
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
